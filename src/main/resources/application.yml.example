app:
    timezone: Asia/Shanghai

spring:
    profiles:
        active: dev
    jackson:
        time-zone: ${app.timezone}
server:
    port: 25001
logging:
    charset:
        console: UTF-8
        file: UTF-8
jasypt:
    encryptor:
        password: example
        algorithm: PBEWITHMD5ANDDES
        bean: jasyptComputer
# Token配置
# Token私钥
token:
    privateKey: example
    # 年轻Token过期时间（毫秒）
    youngToken: 1000000
    # 老Token过期时间（毫秒）
    oldToken: 3000000000

app:
    timezone: Asia/Shanghai

spring:
    profiles:
        active: dev
    jackson:
        time-zone: ${app.timezone}
    rabbitmq:
        publisher-confirm-type: correlated
        publisher-returns: true
        template:
            mandatory: true
server:
    port: 25001
logging:
    charset:
        console: UTF-8
        file: UTF-8
jasypt:
    encryptor:
        password: example
        algorithm: PBEWITHMD5ANDDES
        bean: jasyptComputer
# Token配置
# Token私钥
token:
    privateKey: example
    # Access Token过期时间（毫秒）
    youngToken: 1000000
    # Refresh Token过期时间（毫秒）
    oldToken: 3000000000
